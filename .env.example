# UPI Gateway — Next.js / Neon Postgres port. Placeholders ONLY — never put a
# real value in this file. On Vercel, set these as env vars (DATABASE_URL and
# SESSION_SECRET / ENCRYPTION_KEY as *sensitive*). Locally, copy to .env.local
# (gitignored) and fill in the real values there.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="UPI Gateway"
APP_URL=https://your-domain.example
# Public merchant self-registration is disabled by default.
ALLOW_REGISTRATION=false
BCRYPT_ROUNDS=12
LOG_LEVEL=error

# ─── Database (Neon Postgres) ─────────────────────────────────────────────────
# Pooled connection string supplied by the user (project red-fog-62634170,
# branch production). PLACEHOLDER ONLY — never a real value here.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Secrets (generate fresh; never commit real values) ───────────────────────
# Session signing secret (HS256 JWT, httpOnly cookie). Generate: openssl rand -base64 48
SESSION_SECRET=
# 32-byte key for encrypting stored credentials / API secrets (AES-256-GCM, base64 or hex).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Protects /api/cron/* endpoints. Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_ORDER_EXPIRY_MINUTES=15
GATEWAY_ORDER_CREATE_API_KEY_RATE_LIMIT=1000
GATEWAY_API_KEY_RATE_LIMIT=120
GATEWAY_API_IP_RATE_LIMIT=600
GATEWAY_API_FAILED_AUTH_IP_RATE_LIMIT=30
GATEWAY_LATE_PAYMENT_GRACE_HOURS=24
GATEWAY_LATE_PAYMENT_CHECK_INTERVAL_SECONDS=300
GATEWAY_PENDING_VERIFICATION_BATCH_SIZE=100
GATEWAY_LATE_PAYMENT_BATCH_SIZE=100
GATEWAY_SCHEDULER_LOCK_SECONDS=300
GATEWAY_VERIFICATION_LEASE_SECONDS=120
GATEWAY_EVIDENCE_REQUIRE_TIMESTAMP=true
GATEWAY_EVIDENCE_MAX_AGE_SECONDS=86400
GATEWAY_EVIDENCE_CLOCK_SKEW_SECONDS=300
GATEWAY_PROVIDER_TIMEZONE=Asia/Kolkata
# Set to true ONLY for local dev to allow http:// webhook / redirect URLs.
GATEWAY_WEBHOOK_ALLOW_INSECURE=false
GATEWAY_ALLOW_INSECURE_REDIRECTS=false
GATEWAY_CSP_ENFORCE=true
# Paytm for Business is an UNOFFICIAL status endpoint; disable to block it.
GATEWAY_ENABLE_PAYTM_BUSINESS=true

# ─── QR amounts (Unique Amount QR / Same Amount QR, migration 013) ──────────
# Platform defaults; a merchant's own qr_method / qr_increment_paise columns
# (set in Settings → QR) override these for their orders.
# GATEWAY_QR_METHOD: same (every QR shows the order amount) or unique (each
# live order gets a distinct payable amount a few paise above the order amount).
GATEWAY_QR_METHOD=same
# Paise added per order for unique amounts (1–99). 1 → 500.01, 500.02, ...
GATEWAY_QR_INCREMENT_PAISE=1
# How many candidate amounts to try before giving up with a 409.
GATEWAY_QR_MAX_ALLOCATION_ATTEMPTS=100

# ─── Providers (env credentials only; leave empty until the user supplies them) ─
# Paytm for Business status endpoint (unofficial, may change without notice).
# PAYTM_STATUS_URL=https://securegw.paytm.in/merchant-status/getTxnStatus
# Paytm Payment Gateway base URLs.
# PAYTM_PG_SANDBOX_URL=https://securestage.paytmpayments.com
# PAYTM_PG_PRODUCTION_URL=https://secure.paytmpayments.com
# NOTE: per-merchant Paytm MID / merchant key and PhonePe client_id /
# client_secret / client_version are stored per payment account (encrypted in
# the DB), NOT as env vars. There are no PAYTM_MERCHANT_ID / PHONEPE_* env keys
# in this app — provider credentials come from the merchant's account record.
# (The task brief named PAYTM_MERCHANT_ID/KEY, PAYTM_PG_*, PHONEPE_* as env
# keys; in the source they are per-account credentials, so this port keeps
# them per-account. If a single global provider credential is ever needed,
# add it as an env override in lib/verifiers/ — do not invent values.)

# Optional global provider-credential overrides (reserved, NOT used by default).
# In the source, Paytm/PhonePe credentials live per payment account (encrypted
# in the DB). These env keys are listed here because the migration brief names
# them; they are placeholders for a future single-global-credential mode only.
# Do NOT set them expecting the verifiers to use them — today the verifiers
# read credentials from the merchant's payment-account record.
# PAYTM_MERCHANT_ID=
# PAYTM_MERCHANT_KEY=
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_MERCHANT_ID=
# Webhook signing secrets are per merchant (whsec_… / test_whsec_…), generated
# in Settings and stored encrypted — there is no single global webhook secret.

# ─── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_OUTBOX_BATCH_SIZE=100
WEBHOOK_MAX_DISPATCH_GENERATIONS=10
WEBHOOK_DELIVERY_LOCK_SECONDS=60
WEBHOOK_RETENTION_DAYS=30

# ─── Optional cache/lock backend ──────────────────────────────────────────────
# Only needed if the in-memory + Neon-table rate-limit/cache backend proves
# insufficient (see INVENTORY §5.3). Not required for a first deploy.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
